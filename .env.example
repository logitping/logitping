# Copy this file to .env and fill in the values for the providers your config uses.
# .env is ignored by Git and is not loaded automatically by the update script.
# Export its values in your shell before running npm run bank:update:
#   set -a
#   source .env
#   set +a
# Without set -a, `source .env` creates shell-only variables: echo shows them, but npm/node do not see them.

# Cloudflare AI Gateway: required when any model uses provider "cloudflare" (the default).
# Cloudflare account ID (32 hexadecimal characters).
CLOUDFLARE_ACCOUNT_ID=

# The ID/name of an existing Cloudflare AI Gateway.
CLOUDFLARE_GATEWAY_ID=

# Account-scoped API token with Account > Workers AI > Read permission.
CLOUDFLARE_API_TOKEN=

# OpenRouter: required when any model uses provider "openrouter".
# OpenRouter API key (starts with sk-or-).
OPENROUTER_API_KEY=

# Optional: model and probe configuration; --config overrides this path.
LOGITPING_BANK_CONFIG=config/bank-update.json

# Optional alias used when CLOUDFLARE_GATEWAY_ID is unset or empty.
# CLOUDFLARE_GATEWAY_NAME=
