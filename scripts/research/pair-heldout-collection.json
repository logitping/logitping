{
  "schemaVersion": 1,
  "provider": "openai",
  "protocol": {
    "id": "integer-v1",
    "language": "en",
    "targetSamples": 64,
    "temperature": null
  },
  "checkpoints": [ 64 ],
  "trainingRuns": 25,
  "validationRuns": 15,
  "timeoutMs": 120000,
  "requestDelayMs": 1000,
  "maxRequests": 80,
  "maxProbeRetries": 5,
  "models": [
    {
      "id": "gpt-6.1-sol",
      "family": "gpt",
      "model": "gpt-6.1-sol",
      "apiFormat": "responses",
      "maxTokens": 4096
    },
    {
      "id": "gpt-6-astra",
      "family": "gpt",
      "model": "gpt-6-astra",
      "tokenLimitField": "max_completion_tokens",
      "maxTokens": 4096
    }
  ]
}
